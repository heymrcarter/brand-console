# Settings for `npm run local`, the console as a plain Node process (docs/local-node.md). Copy this file to .env
# (Git ignores it) and fill it in. The names are the same as the Worker's (.dev.vars.example).

# The repository and branch the console reads and makes proposals to.
GITHUB_REPO=heymrcarter/design-system
GITHUB_BRANCH=main

# Either a GitHub App ...
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# ... or a fine-grained personal token for that repository only, with Contents and Pull requests: Read and write.
GITHUB_TOKEN=

# Optional: who changes are credited to. There is no sign-in, so by default it is your Git name and email.
CONSOLE_USER_EMAIL=
CONSOLE_USER_NAME=

# The design guide is off until it goes through the company's AI gateway. Remove this line to turn it back on.
GUIDE=off
# Optional, with the guide on: connects it to Claude.
ANTHROPIC_API_KEY=

# Optional: the port (5173 by default), and NO_OPEN=1 to keep the browser closed.
PORT=

# For npm run install:artifactory: the Artifactory npm registry with the design system packages, and (optional) the one
# for every other package. Your Artifactory sign-in goes in ~/.npmrc, not here.
DESIGN_SYSTEM_REGISTRY=
NPM_REGISTRY=
# The packages' names in Artifactory, if they are not @heymrcarter/design-system and @heymrcarter/design-system-storybook.
DESIGN_SYSTEM_PACKAGE=
STORYBOOK_PACKAGE=
