# Copy this file to .env, then fill in your key to connect the design guide to Claude.
# Get a key at https://console.anthropic.com  (keep it private, never share this file)
ANTHROPIC_API_KEY=
# Optional. The Claude model the design guide uses. claude-sonnet-5 is Anthropic's current Sonnet model.
# Other current models: claude-opus-5-5 (most capable) and claude-haiku-4-5-20251001 (fastest).
# Check https://docs.claude.com for the latest list before you change it.
ANTHROPIC_MODEL=claude-sonnet-5
# Optional. Change these if the ports are busy.
PORT=5173
STORYBOOK_URL=http://localhost:6006
# Optional. Connects the console to your Figma library. The Figma page in the console can fill this in for you.
# Make a token in Figma: Settings, Security, Personal access tokens. Give it these scopes:
# file content (read), file variables (read and write). Variables need Figma's Enterprise plan.
FIGMA_TOKEN=
# Optional. Only to share the console with other computers. Leave these out to keep it on this computer.
# The server will not start shared unless AUTH_BEARER_TOKEN is a long random code (32 characters or more).
# Read docs/hosting-auth.md first. A shared code is a stopgap, not real accounts.
# CONSOLE_HOST=0.0.0.0
# ALLOW_REMOTE=1
# AUTH_BEARER_TOKEN=
