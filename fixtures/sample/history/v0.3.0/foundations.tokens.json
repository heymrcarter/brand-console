{
  "$description": "Foundations shared by every brand.",
  "color": {
    "$type": "color",
    "gray": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4667,
          0.4431,
          0.4157
        ],
        "hex": "#77716a"
      },
      "$description": "The gray that borders, help text, and quiet backgrounds are made from.",
      "$extensions": {
        "org.brand-console": {
          "style": "warm"
        }
      }
    },
    "status": {
      "danger": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.702,
            0.149,
            0.1176
          ],
          "hex": "#b3261e"
        },
        "$description": "Errors and delete buttons."
      },
      "success": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1843,
            0.4314,
            0.3098
          ],
          "hex": "#2f6e4f"
        },
        "$description": "Messages that say something worked."
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5412,
            0.3725,
            0.0549
          ],
          "hex": "#8a5f0e"
        },
        "$description": "Messages that need attention soon."
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": [
          "Public Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Headings."
      },
      "body": {
        "$value": [
          "Public Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Body text."
      },
      "ui": {
        "$value": [
          "Public Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Labels, navigation, tabs, and buttons."
      },
      "$extensions": {
        "org.brand-console": {
          "headingStyle": "normal"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "heading": {
        "$value": 700
      }
    }
  },
  "line-height": {
    "$type": "number",
    "body": {
      "$value": 1.5
    }
  },
  "type-scale": {
    "$type": "number",
    "ratio": {
      "$value": 1.2,
      "$description": "How much bigger each heading is than the one below it."
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 8,
        "unit": "px"
      },
      "$description": "Medium corners. Small and large are made from this."
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "Set by the admin team. Large text multiplies these by about 1.12.",
    "consumer": {
      "text-base": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "control": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "gap": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "inset": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      }
    },
    "employee": {
      "text-base": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "control": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "gap": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "inset": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      }
    }
  },
  "$extensions": {
    "org.brand-console": {
      "defaultShadow": "soft"
    }
  }
}
