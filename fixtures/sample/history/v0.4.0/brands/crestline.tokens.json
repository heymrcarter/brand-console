{
  "$description": "Crestline brand colors. Only this file changes between brands.",
  "$extensions": {
    "org.brand-console": {
      "name": "Crestline",
      "division": "Partner division",
      "wordsOnMainColor": "white"
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1216,
            0.3059,
            0.549
          ],
          "hex": "#1f4e8c"
        },
        "$description": "Main color. Used for buttons, links, and the keyboard focus outline."
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0588,
            0.4824,
            0.4235
          ],
          "hex": "#0f7b6c"
        },
        "$description": "Second color. Used for tags, badges, and selected rows."
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.8784,
            0.6471,
            0.149
          ],
          "hex": "#e0a526"
        },
        "$description": "Accent color. Used for small touches like logos and charts. Never for words."
      }
    },
    "surface": {
      "$description": "Page and window backgrounds for light and dark mode. Picked from the brand's color set.",
      "light": {
        "page": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "hex": "#ffffff"
          },
          "$description": "The page background.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "card": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "hex": "#ffffff"
          },
          "$description": "Windows, cards, and pop-ups.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "window-opacity": {
          "$type": "number",
          "$value": 1,
          "$description": "How solid windows and cards are. 1 is fully solid."
        },
        "window-blur": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          },
          "$description": "How much windows blur what is behind them."
        }
      },
      "dark": {
        "page": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0078,
              0.0824,
              0.1961
            ],
            "hex": "#021532"
          },
          "$description": "The page background.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "card": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0157,
              0.2,
              0.1725
            ],
            "hex": "#04332c"
          },
          "$description": "Windows, cards, and pop-ups.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "window-opacity": {
          "$type": "number",
          "$value": 1,
          "$description": "How solid windows and cards are. 1 is fully solid."
        },
        "window-blur": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          },
          "$description": "How much windows blur what is behind them."
        }
      }
    }
  }
}
