{
  "name": "brand-console",
  "version": "1.0.0",
  "private": true,
  "description": "The Brand Console: where the brand team edits the design system (@heymrcarter/design-system), checks it, and publishes. Runs on Cloudflare Workers, or as a plain Node server on one computer.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "local": "node scripts/local.mjs",
    "local:sample": "node scripts/local.mjs --sample",
    "install:artifactory": "node scripts/install-artifactory.mjs",
    "worker:assets": "node scripts/build-worker-assets.mjs",
    "worker:dev": "node scripts/build-worker-assets.mjs && wrangler dev",
    "worker:deploy": "node scripts/deploy-worker.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:worker": "node scripts/test-worker.mjs",
    "reset-sample-data": "node scripts/seed.mjs",
    "audit": "node scripts/audit-contrast.mjs",
    "check:colors": "node scripts/consistency-audit.mjs",
    "stress": "node scripts/stress-audit.mjs 16",
    "sweep": "node scripts/bug-sweep.mjs",
    "check:all": "npm test && npm run test:worker && npm run audit && npm run check:colors && npm run stress && npm run sweep",
    "prepare": "skills-npm"
  },
  "dependencies": {
    "@heymrcarter/design-system": "1.8.0",
    "@heymrcarter/design-system-storybook": "1.8.0",
    "jose": "^6.2.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@antfu/skills": "^0.1.0",
    "skills-npm": "^4.0.0",
    "vite": "^8.3.1",
    "wrangler": "^4.147.0"
  }
}
