              0.2392
            ],
            "hex": "#3a3b3d"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Charcoal",
              "share": 6,
              "order": 3
            }
          }
        },
        "berry": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.6314,
              0.1255,
              0.3804
            ],
            "hex": "#a12061"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Berry",
              "share": 6,
              "order": 4
            }
          }
        },
        "light-teal": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.4784,
              0.7216,
              0.7647
            ],
            "hex": "#7ab8c3"
          },
          "$extensions": {
            "org.brand-console": {
