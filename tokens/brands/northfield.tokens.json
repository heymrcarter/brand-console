{
  "$description": "Northfield brand colors. Only this file changes between brands.",
  "$extensions": {
    "org.brand-console": {
      "name": "Northfield",
      "division": "Consumer division",
      "wordsOnMainColor": "white",
      "shadeRangeFrom": {
        "primary": "#6A9835"
      }
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2471,
            0.3961,
            0.0314
          ],
          "hex": "#3f6508"
        },
        "$description": "Main color. Used for buttons, links, and the keyboard focus outline."
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5333,
            0.7373,
            0.251
          ],
          "hex": "#88bc40"
        },
        "$description": "Second color. Used for tags, badges, and selected rows."
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0588,
            0.1843,
            0.3333
          ],
          "hex": "#0f2f55"
        },
        "$description": "Accent color. Used for small touches like logos and charts. Never for words."
      }
    },
    "surface": {
      "$description": "Page and window backgrounds for light and dark mode. Picked from the brand's color set.",
      "light": {
        "page": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "hex": "#ffffff"
          },
          "$description": "The page background.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "card": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "hex": "#ffffff"
          },
          "$description": "Windows, cards, and pop-ups.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "window-opacity": {
          "$type": "number",
          "$value": 1,
          "$description": "How solid windows and cards are. 1 is fully solid."
        },
        "window-blur": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          },
          "$description": "How much windows blur what is behind them."
        }
      },
      "dark": {
        "page": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.051,
              0.1059,
              0
            ],
            "hex": "#0d1b00"
          },
          "$description": "The page background.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "card": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.1216,
              0.1961,
              0.0078
            ],
            "hex": "#1f3202"
          },
          "$description": "Windows, cards, and pop-ups.",
          "$extensions": {
            "org.brand-console": {
              "automatic": true
            }
          }
        },
        "window-opacity": {
          "$type": "number",
          "$value": 1,
          "$description": "How solid windows and cards are. 1 is fully solid."
        },
        "window-blur": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          },
          "$description": "How much windows blur what is behind them."
        }
      }
    },
    "palette": {
      "signature": {
        "$description": "These greens are what people should know as Northfield. The medium green leads, and the light green supports it.",
        "$extensions": {
          "org.brand-console": {
            "name": "Signature color",
            "order": 0
          }
        },
        "signature-green": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.4157,
              0.5961,
              0.2078
            ],
            "hex": "#6a9835"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Signature green",
              "share": 18,
              "order": 0
            }
          }
        },
        "light-green": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.5333,
              0.7373,
              0.251
            ],
            "hex": "#88bc40"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Light green",
              "share": 12,
              "order": 1
            }
          }
        }
      },
      "greens": {
        "$description": "A deeper green that goes with the signature greens.",
        "$extensions": {
          "org.brand-console": {
            "name": "Spectrum of greens",
            "order": 1
          }
        },
        "forest-green": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.1373,
              0.2863,
              0.1412
            ],
            "hex": "#234924"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Forest green",
              "share": 12,
              "order": 0
            }
          }
        }
      },
      "base": {
        "$description": "The main background. It gives the other colors room to stand out.",
        "$extensions": {
          "org.brand-console": {
            "name": "Base",
            "order": 2
          }
        },
        "white": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "hex": "#ffffff"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "White",
              "share": 20,
              "order": 0
            }
          }
        }
      },
      "accent": {
        "$description": "Use these in small amounts, like in charts, icons, and highlights.",
        "$extensions": {
          "org.brand-console": {
            "name": "Accent colors",
            "order": 3
          }
        },
        "navy": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.1843,
              0.3333
            ],
            "hex": "#0f2f55"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Navy",
              "share": 6,
              "order": 0
            }
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.349,
              0.1451,
              0.3882
            ],
            "hex": "#592563"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Purple",
              "share": 6,
