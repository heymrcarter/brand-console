            ],
            "hex": "#c8c8c8"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Light gray",
              "share": 2,
              "order": 6
            }
          }
        },
        "coral": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9137,
