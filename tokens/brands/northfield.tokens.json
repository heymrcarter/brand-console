              0.4627
            ],
            "hex": "#e95f76"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Coral",
              "share": 2,
              "order": 7
            }
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9686,
              0.7843,
              0.2667
            ],
            "hex": "#f7c844"
          },
          "$extensions": {
            "org.brand-console": {
              "name": "Yellow",
              "share": 2,
              "order": 8
            }
          }
        }
      }
    }
  }
}
