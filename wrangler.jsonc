// The Brand Console on Cloudflare Workers. Setup steps are in docs/cloudflare.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brand-console",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  // The console's files and Storybook, made by: npm run worker:assets
  "assets": {
    "directory": "./.worker-assets",
    "binding": "ASSETS",
    // Every request goes to the Worker first, so nothing is served without a Cloudflare Access sign-in.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // One Durable Object per design system repository and branch. It orders the writes and holds unpublished changes.
  "durable_objects": {
    "bindings": [
      {
        "name": "DESIGN_SYSTEM",
        "class_name": "DesignSystem"
      }
    ]
  },
  "exports": {
    "DesignSystem": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  // No settings here on purpose. GitHub Actions deploys the Worker with the settings and secrets stored in the
  // repository (Settings > Secrets and variables > Actions); see scripts/deploy-worker.mjs. A `wrangler deploy` from
  // anywhere else ships no settings, and the Worker then refuses every request until Actions deploys it again.
  // For wrangler dev on your computer, put settings in .dev.vars, which Git ignores (see .dev.vars.example).
  "observability": {
    "enabled": true
  },
  // Pull request previews (Cloudflare Workers Previews: wrangler preview --name pr-<number>). Each one gets its own
  // Durable Object storage, so its edits and Figma connection never touch the real console's. The binding must be
  // named again here for previews to have it. Settings come from the workflow, like production's.
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "DESIGN_SYSTEM",
          "class_name": "DesignSystem"
        }
      ]
    }
  }
}